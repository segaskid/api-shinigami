{
  "name": "api-shinigami",
  "version": "0.5.0",
  "description": "A terminal-native API testing, debugging, and automation toolkit.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/segaskid/api-shinigami.git"
  },
  "bugs": {
    "url": "https://github.com/segaskid/api-shinigami/issues"
  },
  "homepage": "https://github.com/segaskid/api-shinigami#readme",
  "bin": {
    "shinigami": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "USAGE.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "prepare": "npm run build",
    "check": "npm run lint && npm run test && npm run build"
  },
  "keywords": [
    "api",
    "cli",
    "http",
    "testing",
    "automation"
  ],
  "author": "vega",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.3.3",
    "ajv": "^8.17.1",
    "chalk": "^5.4.1",
    "cli-table3": "^0.6.5",
    "commander": "^13.1.0",
    "env-paths": "^3.0.0",
    "fast-glob": "^3.3.3",
    "fs-extra": "^11.3.0",
    "ora": "^8.2.0",
    "undici": "^7.4.0",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.13.10",
    "eslint": "^9.21.0",
    "prettier": "^3.5.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.0",
    "vitest": "^3.0.8"
  }
}
